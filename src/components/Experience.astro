---
import SectionLabel from './ui/SectionLabel';
const jobs = [
  { ini: 'WG', role: 'AI Engineering Intern', co: 'Web3 Geeks · Pakistan', meta: 'Remote · Aug 2026 – Sept 2026', pts: [
    'Built multi-agent systems in LangChain, LangGraph, and CrewAI with HITL interrupts, self-correction loops, and grounded RAG',
    'Shipped a production UrduLish real-estate voice agent (FastAPI + Docker +  11-node LangGraph; Groq Whisper + Edge TTS).',
    '20/20 grounded responses on a self-curated held-out evaluation (20 edge-case queries across 4 cities) and 0 hallucination failures.',
    'Integrated Google Calendar + Gmail for end-to-end booking lifecycle(book / reschedule / cancel) — verified live with real production APIs',
    'Engineered 8 domain features and tuned an ML pipeline (RandomizedSearchCV + calibration) on UCI Adult Census, lifting ROC-AUC 0.72 → 0.93 and F1 0.49 → 0.73',
    'Hardened against 127 adversarial attacks, authored 775-test suite, produced 20 production docs' ] },
  { ini: 'BM', role: 'AI Intern', co: 'Bookme · Pakistan', meta: 'Onsite · Summer 2025', pts: [
    'Designed and deployed a personalized AI chatbot with RAG pipelines and real-time communication via Ably Protocol',
    'Implemented custom guardrails for safe, contextually accurate LLM responses',
    'Evaluated LangChain limitations and migrated the pipeline to Pydantic AI' ] },
];
---
<section id="experience" class="sec tint">
  <div class="wrap">
    <SectionLabel reveal>EXPERIENCE</SectionLabel>
    <h2 class="h2" data-reveal style="--i:1">Experience</h2>
    <div id="tl" class="relative mt-14 pl-9 md:pl-12">
      <div class="absolute bottom-3 left-[7px] top-3 w-px bg-line" aria-hidden="true">
        <div id="tl-fill" class="h-full w-full origin-top bg-gradient-to-b from-brand-dim to-brand" style="transform:scaleY(0)"></div>
      </div>
      {jobs.map((j, i) => (
        <article data-reveal style={`--i:${i}`} class="group relative pb-12 last:pb-0">
          <span aria-hidden="true" class="absolute -left-9 top-11 h-[15px] w-[15px] rounded-full bg-brand ring-4 ring-base transition-shadow duration-300 group-hover:shadow-[0_0_20px_6px_rgba(16,214,149,0.55)] md:-left-12"></span>
          <div class="card card-css p-8 transition-transform duration-500 group-hover:translate-x-1.5 md:p-10">
            <div class="flex items-start gap-4">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-[linear-gradient(135deg,#0a8f6a,#10d695)] p-[2px]" aria-hidden="true">
                <span class="grid h-full w-full place-items-center rounded-full bg-elev font-mono text-[12px] font-medium text-brand">{j.ini}</span>
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-display text-[20px] font-bold leading-tight tracking-[-0.01em]">{j.role}</h3>
                <p class="mt-1 text-t2">{j.co}</p>
                <p class="mono-tag mt-2 text-t3">{j.meta}</p>
              </div>
            </div>
            <ul class="mt-7 space-y-3 text-t2">
              {j.pts.map((p) => (
                <li class="flex gap-3">
                  <svg class="mt-[7px] h-4 w-4 shrink-0 text-brand" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  const tl = document.getElementById('tl')!, fill = document.getElementById('tl-fill')!;
  const update = () => {
    const r = tl.getBoundingClientRect();
    fill.style.transform = `scaleY(${Math.min(1, Math.max(0, (window.innerHeight * 0.65 - r.top) / r.height))})`;
  };
  update(); window.addEventListener('scroll', update, { passive: true }); window.addEventListener('resize', update);
</script>
