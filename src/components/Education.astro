---
import SectionLabel from './ui/SectionLabel';

const C = 2 * Math.PI * 54;
const off = C * (1 - 3.2 / 4);

const coursework = [
  'Programing Fundamentals',
  'Software Engineering',
  'Machine Learning',
  'Deep Learning',
  'Data Structures',
  'Databases',
  'NLP',
];
---
<section id="education" class="sec">
  <div class="wrap">
    <SectionLabel reveal>EDUCATION</SectionLabel>
    <h2 class="h2" data-reveal style="--i:1">Education</h2>
    <div data-reveal style="--i:2" class="mt-14">
      <article class="card card-css p-8 md:p-12">
        <div class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
          <div class="flex items-start gap-5">
            <span
              class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-brand-dim font-display text-lg font-extrabold text-white"
              aria-hidden="true"
            >
              UET
            </span>
            <div class="min-w-0">
              <h3 class="h3">Bachelor of Software Engineering</h3>
              <p class="mt-2 text-t2">University of Engineering and Technology (UET), Lahore</p>
              <p class="mono-tag mt-3 uppercase text-t3">2022 – 2026</p>

              <p class="mt-4 text-[14px] text-t2">
                Final Year Project:{' '}
                <a href="#projects" class="text-brand hover:underline">
                  Neat Now — AI Waste Detection System
                </a>{' '}
                (YOLOv8m, 82.5% mAP@50)
              </p>

              <ul class="mt-5 flex flex-wrap gap-2">
                {coursework.map((c) => (
                  <li class="rounded-full border border-line px-3 py-1 text-[12px] text-t2">
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="relative h-32 w-32 shrink-0" role="img" aria-label="CGPA 3.2 out of 4.0">
            <svg viewBox="0 0 128 128" class="h-full w-full -rotate-90" aria-hidden="true">
              <defs>
                <linearGradient id="cg" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#0a8f6a" />
                  <stop offset="1" stop-color="#8b9eff" />
                </linearGradient>
              </defs>
              <circle
                cx="64"
                cy="64"
                r="54"
                fill="none"
                stroke="rgba(255,255,255,0.08)"
                stroke-width="8"
              />
              <circle
                class="ring-fg"
                cx="64"
                cy="64"
                r="54"
                fill="none"
                stroke="url(#cg)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-dasharray={C}
                style={`--full:${C};--off:${off}`}
              />
            </svg>
            <div class="absolute inset-0 grid place-content-center text-center">
              <span class="font-display text-3xl font-extrabold leading-none">3.2</span>
              <span class="mono-tag mt-1 uppercase text-t3">CGPA / 4.0</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>